<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <!-- Cabeçalho -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recibo_pagamento"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"
        android:textColor="@color/black" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        android:layout_marginBottom="24dp" />

    <!-- Dados da Empresa -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DADOS DA EMPRESA:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvEmpresaRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvResponsavelRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvDocumentoResponsavelRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/black" />

    <!-- Dados do Cliente -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DADOS DO CLIENTE:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvNomeClienteRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvDocumentoClienteRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/black" />

    <!-- Detalhes do Pagamento -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DETALHES DO PAGAMENTO:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvServicoRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvValorRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvValorExtensoRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvDataPagamentoRecibo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"
        android:textColor="@color/black" />

    <!-- Assinaturas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="48dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/imgAssinaturaResponsavel"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:src="@drawable/assinatura"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNomeResponsavelAssinatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/assinatura_responsavel"
                android:textSize="12sp"
                android:textAlignment="center"
                android:textColor="@color/black" />

        </LinearLayout>

    </LinearLayout>

    <!-- Rodapé -->
    <TextView
        android:id="@+id/tvDataGeracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        android:textColor="@color/text_secondary" />

</LinearLayout>

